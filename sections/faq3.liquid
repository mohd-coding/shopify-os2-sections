<style>
.faq3_row[open] .icon-minus {
    display: flex !important;
    align-items: center;
    justify-content: center
}
.faq3_row[open] .icon-minus {
    display: inline !important
}
.faq3_row[open] .icon-plus {
    display: none;
}
.faq3_question::webkit-details-marker {
    display: none
    }
.faq3_answer {
    padding-top: 12px;
    color: #555;
    line-height: 1.6;
    font-size: 14px
}
.faq3_question {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-weight: 700;
    font-size: 16px
}
.faq3_row {
    border-bottom: 1px solid #ddd;
    padding: 15px 0
}
.faq3_question::-webkit-details-marker {
    display: none
}
.icon { 
        background: #000;
        color: #fff;
        width: 28px; 
        height: 28px; 
        border-radius: 50%; 
        display:flex;
        align-items:center; 
        justify-content:center
}
</style>



<div class="faq3-wrapper"  style="max-width:750px; margin:40px auto; font-family:sans-serif">
 <h2  style="text-align:center; font-size:32px; margin-bottom:25px"> 
 {{section.settings.heading}}
  </h2>
  
  {% for block in section.blocks %}
    <details class="faq3_row"  {{block.shopify_attributes}}>
    <summary class="faq3_question"> {{ block.settings.question }}
    <span class="icon icon-plus"> + </span>
    <span class="icon-minus" style="display:none"> - </span>
   {% comment %}
    {%  if section.settings.icon_type == 'plus' %}+{% else %}-{% endif %}
   </span>
   {% endcomment %}
     </summary>
    <div class="faq3_answer">{{ block.settings.answer }} </div>
    </details>
   {% endfor %} 
</div>

<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "FAQpage",
    "mainEntity": [
        {% for block in section.blocks %}
        {
            "@type": "Question",
            "name": "{{ block.settings.question | json }}",
            "acceptedAnswer":" {
                 "@type": "Answer",
                 "text": "{{ block.settings.answer | strip_html | json }}"
            }
        }{% unless forloop.last %},{%endunless%}
        {%endfor%}
    ]
}
</script>

{%schema%}
{
    "name":"FAQ3",
    "settings":[
        {
            "type":"text",
            "id":"heading",
            "label":"Heading",
            "default":"Frequently Asked Questions"
        },
        
        { 
           "type":"select",
            "id":"icon_type",
            "label":"Icon Style",
            "options": [{"value":"plus", "label":"Plus"},{"value":"arrow", "label":"Arrow"}], "default":"plus" 
        }
    ],
    "blocks":[
        {
            "type":"faq3_item",
            "name":"FAQ",
            "settings":[
                {
                    "type":"text",
                    "id":"question",
                    "label":"Question"
                },
                {
                    "type":"textarea",
                    "id":"answer",
                    "label":"Answer"
                }
            ]
        }
    ],
    "presets":[{
        "name":"FAQ3"
    }]
}
{%endschema%}